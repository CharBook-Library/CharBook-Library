APP_NAME="CharBook Library"
APP_ENV=local
# Genera la tuya con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL del frontend Next.js (CORS + redirección post-OAuth)
FRONTEND_URL=http://localhost:3000

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Base de datos (PostgreSQL) =====
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=charbook
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===== Correo =====
# Local sin correo real: MAIL_MAILER=log (los correos se escriben en storage/logs).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="CharBook Library"

# Gmail SMTP (usa una "contraseña de aplicación" de Google, no tu contraseña normal):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_FROM_ADDRESS=tu-correo@gmail.com
# MAIL_FROM_NAME="CharBook Library"
#
# Outlook / Microsoft 365 SMTP:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@outlook.com
# MAIL_PASSWORD=tu-password-o-app-password
# MAIL_FROM_ADDRESS=tu-correo@outlook.com
# MAIL_FROM_NAME="CharBook Library"

# ===== Resend (opcional, emails transaccionales) =====
# RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Cloudflare R2 (almacenamiento de libros y portadas) =====
# Necesario para subir libros y portadas. Crea dos buckets en Cloudflare R2
# y un API token con lectura/escritura sobre ellos.
# Prueba la conexión con: php artisan r2:test
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BOOKS_BUCKET=charbook-books
R2_COVERS_BUCKET=charbook-covers
R2_COVERS_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ===== Google OAuth (login con Google) + Google Books =====
# Créalas en https://console.cloud.google.com/apis/credentials
# En la consola de Google registra como "Authorized redirect URI" el valor de GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_BOOKS_API_KEY=
# App móvil (Expo Go en desarrollo): exp://<ip-de-tu-pc>:8081/--/auth/callback
GOOGLE_MOBILE_REDIRECT_URI=charbookreact://auth/callback

# ===== Meilisearch (búsqueda) =====
# "collection" funciona sin instalar nada (búsqueda directa en la BD).
# Si instalas Meilisearch (puerto 7700), cambia a SCOUT_DRIVER=meilisearch
SCOUT_DRIVER=collection
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ===== Super Admin =====
# La cuenta con este correo recibe el rol de super admin.
SUPER_ADMIN_EMAIL=admin@example.com

# ===== Stripe (monetización) =====
# Claves de modo prueba: https://dashboard.stripe.com/test/apikeys
# Webhook local:  stripe listen --forward-to localhost:8000/api/webhooks/stripe
# (el comando imprime el whsec_... que va en STRIPE_WEBHOOK_SECRET)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
