APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Reverse proxies only. Use explicit IP/CIDR values; *, ** and REMOTE_ADDR are rejected.
# For a local ngrok agent: 127.0.0.1,::1
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

HEALTH_SCHEDULER_REQUIRED=false
HEALTH_SCHEDULER_STALE_SECONDS=180

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_AFTER_COMMIT=true
DB_QUEUE_RETRY_AFTER=1900

CACHE_STORE=database
# Usa un valor distinto por ambiente si comparte el mismo servidor.
# CACHE_PREFIX=charbook_local_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_CACHE_URL=
REDIS_QUEUE_URL=
REDIS_SESSION_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
# Debe ser unico por ambiente (production, staging, loadtest).
# REDIS_PREFIX=charbook_local_redis_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
# Debe superar el timeout del job mas largo (importacion: 1800 s).
REDIS_QUEUE_RETRY_AFTER=1900
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_AFTER_COMMIT=true
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# Produccion recomendada (requiere Redis y phpredis/predis):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# SESSION_CONNECTION=session
# SESSION_SECURE_COOKIE=true

# Local: usa "log" o "array". Produccion/correo real: usa "smtp".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@charbooklibrary.com"
MAIL_FROM_NAME="CharBook Library"

# Google OAuth. In production GOOGLE_CALLBACK_URL must be the exact HTTPS URL
# registered in Google Cloud, for example https://api.example.com/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALLBACK_URL=
GOOGLE_MOBILE_REDIRECT_URI=charbookreact://auth/callback

# Gmail SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=tu-correo@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_FROM_ADDRESS=tu-correo@gmail.com
# MAIL_FROM_NAME="CharBook Library"
#
# Outlook / Microsoft 365 SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=tu-correo@outlook.com
# MAIL_PASSWORD=tu-password-o-app-password
# MAIL_FROM_ADDRESS=tu-correo@outlook.com
# MAIL_FROM_NAME="CharBook Library"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups cifrados. Mantener un bucket y credenciales exclusivos y privados.
BACKUP_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_DISK=backup
BACKUP_PATH=charbook
BACKUP_SOURCE_DISKS=public,r2_books,r2_covers
BACKUP_ALLOWED_ENVIRONMENTS=production,staging
BACKUP_RETENTION_DAYS=30
BACKUP_DAILY_AT=03:30
BACKUP_PRUNE_AT=04:30
BACKUP_VERIFY_UPLOAD=true
# Generar fuera del repositorio: 32 bytes codificados en base64.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=true
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore
BACKUP_PROCESS_TIMEOUT=3600
BACKUP_LOCK_SECONDS=21600
BACKUP_RESTORE_DATABASE=charbook_restoretest
BACKUP_MAX_FILES=100000
BACKUP_MAX_FILE_BYTES=2147483648
BACKUP_MAX_TOTAL_BYTES=107374182400
BACKUP_MAX_ARCHIVE_BYTES=107374182400
BACKUP_MAX_ENCRYPTED_BYTES=108447924224
BACKUP_MAX_MANIFEST_BYTES=5242880

VITE_APP_NAME="${APP_NAME}"
