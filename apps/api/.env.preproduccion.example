# Plantilla del .env de PREPRODUCCIÓN.
# Se copia al servidor como <base>/shared/.env y ahí se llenan los valores reales.
# Este archivo sí viaja en el paquete porque no tiene ningún secreto.
# Compara los nombres con tu .env.example y ajusta los que sean distintos.

APP_NAME="CharBook Library (preproducción)"
APP_ENV=staging
# Se genera con: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://preprod.charbook.example

LOG_CHANNEL=stack
LOG_LEVEL=info

# Base de datos propia de preproducción (no compartir con desarrollo ni producción)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=charbook_preprod
DB_USERNAME=charbook_preprod
DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR

# Cache, colas y sesiones
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Búsqueda (Laravel Scout + Meilisearch)
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=CAMBIAR_EN_EL_SERVIDOR

# Almacenamiento (Cloudflare R2, usa el driver s3). Bucket distinto al de producción
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CAMBIAR_EN_EL_SERVIDOR
AWS_SECRET_ACCESS_KEY=CAMBIAR_EN_EL_SERVIDOR
AWS_DEFAULT_REGION=auto
AWS_BUCKET=charbook-preprod
AWS_ENDPOINT=https://CUENTA.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Inicio de sesión con Google (credenciales de pruebas)
GOOGLE_CLIENT_ID=CAMBIAR_EN_EL_SERVIDOR
GOOGLE_CLIENT_SECRET=CAMBIAR_EN_EL_SERVIDOR
GOOGLE_REDIRECT_URI=https://preprod.charbook.example/auth/google/callback

# Correos
MAIL_MAILER=log
